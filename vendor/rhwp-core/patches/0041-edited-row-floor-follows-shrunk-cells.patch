     )
 }
 
+/// 행마다 행 병합 없는 셀이 저장한 높이의 최댓값(px). 값이 없는 행은 0이다.
+fn declared_row_heights_px_with_storage<S: crate::storage::Storage>(
+    table: &crate::model::table::Table,
+    row_count: usize,
+    dpi: f64,
+    storage: &S,
+) -> Result<Vec<f64>, S::Error> {
+    let mut rows = storage.filled(row_count, 0.0f64)?;
+    for cell in &table.cells {
+        let row = cell.row as usize;
+        if cell.row_span != 1 || row >= row_count || cell.height >= 0x8000_0000 {
+            continue;
+        }
+        let height = hwpunit_to_px(cell.height as i32, dpi);
+        if height > rows[row] {
+            rows[row] = height;
+        }
+    }
+    Ok(rows)
+}
